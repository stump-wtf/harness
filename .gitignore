# Agent worktrees. Claude Code creates these in-repo; a worktree visible to
# git, builds, linters, or a `git ls-files` glob breaks all four.
.claude/worktrees/

docs-site/node_modules/
docs-site/build/
docs-site/.docusaurus/
docs-generated/
bin/
dist/
# `make build` writes to bin/, but a hand-run `go build -o harness ./cmd/harness`
# drops a 13MB binary at the repo root. Root-anchored so cmd/harness/ is unaffected.
/harness

# Worktrees
.claude/
