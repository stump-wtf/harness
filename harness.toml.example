# harness.toml — example configuration.
#
# Copy to ~/.config/harness/harness.toml and edit. After editing, re-run
# `harness doctor` to verify the daemon picks it up. Full field reference:
# `harness daemon -h`.
#
# Default location: $XDG_CONFIG_HOME/harness/harness.toml
# (falls back to ~/.config/harness/harness.toml).

# Optional daemon-level settings (issue #98).
#
# [daemon]
# # watch_config controls whether the daemon watches this file for changes
# # and auto-reloads. Default is true (on). Set to false to require an
# # explicit `harness reload` or SIGHUP after config changes.
# watch_config = true

# Optional agent telemetry export (ADR-0022, SPEC-0015). Nothing leaves the
# daemon unless a destination below is on AND a harness is opted in with
# export_telemetry = true (or export_all = true). Collector credentials never
# go here: put OTEL_EXPORTER_OTLP_HEADERS in the env_file. Changing this table
# needs a daemon restart. See docs/usage/production-observability.md.
#
# [telemetry]
# logs = true                        # OTLP logs, one record per tool call/mark
# traces = true                      # OTLP traces, one per agent session
# events_file = "~/.local/state/harness/events.jsonl"  # local JSONL, no network
# endpoint = "http://127.0.0.1:4318" # or OTEL_EXPORTER_OTLP_ENDPOINT
# env_file = "/etc/harness/otel.env" # OTEL_EXPORTER_OTLP_* incl. headers
# export_all = false

# Each harness is one supervised process. The new-style [harness.<name>]
# form is preferred; a bare [name] table is supported for backward
# compatibility (ADR-0006).

# A simple always-on ticker. enabled = true means the daemon autostarts it
# on boot (ADR-0005 supervision: it gets restarted if it exits, with
# escalating backoff under crash-loop conditions).
[harness.heartbeat]
harness = "generic"
args = ["-c", "while true; do echo $(date); sleep 60; done"]
description = "prints the time once a minute"
enabled = true

# An agent CLI you drive from your phone via the remote SSH surface.
# Disabled by default so it doesn't spawn until you explicitly `harness start`.
[harness.my-agent]
harness = "claude-code"
args = ["--remote-control", "--dangerously-skip-permissions"]
workdir = "~/src/my-project"
description = "long-running agent in ~/src/my-project"
enabled = false

# An agent one-shot: give the harness a prompt instead of args and the
# daemon synthesizes the agent invocation at spawn time from the harness's
# adapter (claude-code: `claude -p … <prompt>`; crush: `crush run … <prompt>`;
# codex: `codex exec … <prompt>`; pi and omp: `pi --print … <prompt>`, `omp
# --print … <prompt>`). `prompt` is mutually exclusive with
# `args`. One-shots default to restart = "no" — a completed run must
# not respawn; set restart explicitly to opt back into supervision.
[harness.deploy-check]
harness = "claude-code"
prompt = "check the deployments and report anything unhealthy"
model = "claude-opus-5"  # optional: which model the agent runs (requires prompt)
# auto_accept runs the agent unattended (the adapter's own flag, synthesized at
# spawn: --dangerously-skip-permissions for claude-code, --yolo for crush,
# --full-auto for codex; nothing for pi and omp, which never prompt). WARNING:
# this bypasses ALL of the agent's permission
# prompts — only enable it for trusted, headless runs. Requires `prompt`; a
# long-running harness passes its tool's own flag through `args` instead.
auto_accept = true
# max_turns caps how many iterations the agent may run before it stops — the
# budget guard for unattended one-shots (requires `prompt`; a long-running harness
# passes its tool's flag through `args`). 0 or omitted means unlimited. Only the
# claude-code adapter has a turn-cap flag; crush, codex, pi and omp ignore it.
max_turns = 20
# quiet runs the one-shot headless (suppresses agent output). It is the
# default for a prompt harness, so set quiet = false to have the agent stream
# its output to whatever attaches instead. Requires `prompt`; a long-running harness
# passes its tool's own tone flag through `args`.
# quiet = false
workdir = "~/src/my-project"
description = "one-shot agent run"
enabled = false

# A scheduled agent one-shot: the daemon fires it on a cron schedule. At each
# firing the harness starts if it is not already running (overlapping firings
# are skipped, not stacked). Requires `prompt`; is mutually exclusive with
# `enabled = true` and with profile membership. The run exiting is terminal
# for that firing — restart policy applies only to abnormal exit, so only
# `restart = "no"` (the prompt default) or `"on-failure"` are accepted here.
# The cron expression is validated at load; global config only (not project
# files).
#
# [harness.fleet-sweep]
# harness = "crush"
# prompt = "check all services and report anything unhealthy"
# auto_accept = true
# schedule = "CRON_TZ=UTC 0 */6 * * *"   # every 6 hours, pinned to UTC
# description = "fleet health sweep"   # say what it does; the cadence is its own column

# Operating hours (ADR-0019): weekly windows a RESIDENT harness is allowed to
# run in. Outside them the daemon holds it down (stops the process without
# touching `enabled`) and starts it again when a window opens — the same
# distinction the TUI shows as "off-hours", never "stopped". Global config
# only (like `schedule`, not supported in a project harness.toml) and
# mutually exclusive with `schedule` (a scheduled one-shot is already
# time-gated by its own cron expression). Grammar: an optional TZ=/CRON_TZ=
# zone prefix (same resolution as `schedule`'s), then ";"-separated windows of
# "[days] HH:MM-HH:MM" — a day-less window applies every day, a day range
# wraps the week ("Fri-Mon" is Fri/Sat/Sun/Mon), and an end at or before its
# start (other than the explicit end-of-day 24:00) runs into the next day.
#
# hours_shutdown decides how a close runs: "graceful" (the default) waits for
# the agent to finish its current turn, capped by hours_shutdown_timeout
# (default 15m); "immediate" stops it at once. Both require operating_hours.
#
# [harness.night-owl]
# harness = "claude-code"
# args = ["--remote-control", "--continue"]
# enabled = true
# operating_hours = "TZ=America/Los_Angeles Mon-Fri 09:00-13:00"
# hours_shutdown = "graceful"           # or "immediate"; default "graceful"
# hours_shutdown_timeout = "15m"        # default "15m"; must be a positive duration
#
# A late night: `harness start night-owl` outside its hours runs it under a
# one-hour after-hours lease by default, or `harness start night-owl --for
# 3h` for a longer one. The gate stops it at the lease's end exactly as it
# would at a close; `harness stop night-owl` always ends the lease early and
# clears `enabled`, in or out of hours. `harness list`/`describe` and the TUI
# show a leased harness's NEXT column as "lease until <time>", distinct from
# both "off-hours" (held) and "closing" (a graceful close in flight).

# Harness kinds (ADR-0011, SPEC-0006): the `harness` key is an enum selecting
# the adapter, which owns the executable a long-running harness runs (args are
# appended after it) and the CLI-specific argv synthesized for a prompt
# one-shot. REQUIRED -- there is no default. "generic" runs sh, so its args
# are sh's args (args = ["-c", "<command line>"]; no projection,
# scrollback-only trajectory). "generic" takes NO prompt: it has no prompt
# synthesis, so prompt or prompt_file on it is a config error (it used to run
# crush).
# "command" runs any other program WITHOUT a shell: its `argv` array is the
# whole process, argv[0] first, and each element reaches the program as one
# byte-identical argument ("a b" is one argument; $(...) and ; are just text).
# argv[0] is looked up on PATH, or resolved against workdir when it is a
# relative path containing "/". `args` is rejected on "command" and `argv` on
# every other kind; auto_accept, max_turns, quiet and model are rejected (put
# the program's own flags in argv). For now a command harness is resident
# only: prompt, prompt_file, schedule and triggers are refused, and argv may
# not contain "{{" (templates are still to come, ADR-0023, issue #500). This is
# how an agent CLI without an adapter runs; `transcripts = "claude-code"` (or
# crush, codex, pi, omp) on a command harness observes its sessions as that
# agent's. Pi and OMP have adapters of their own ("pi", "omp"); OMP's sessions
# are not observed yet.
# Valid values: "crush", "claude-code", "codex", "pi", "omp", "generic",
# "command".
#
# harness = "claude-code"   # required on every [harness.*] table
#
# [harness.report-server]
# harness = "command"
# argv = ["/usr/local/bin/report", "--listen", ":8080", "--title", "Nightly report"]
# workdir = "~/src/report"
# enabled = true
#
# [harness.claude-by-hand]
# harness = "command"
# argv = ["claude", "--remote-control", "--continue"]
# transcripts = "claude-code"
# workdir = "~/src/app"

# Trajectory harvesting (SPEC-0006 REQ "Harvest Opt-In"): the opt-in for
# exposing this harness's session transcripts read-only through the MCP facade
# (list_trajectories / get_trajectory). Defaults to false - a transcript may
# contain secrets the harnessed program printed itself (ADR-0008). NOTE: the
# daemon does not run the MCP facade yet, so this key and mcp_allow below are
# validated but have no runtime effect today.
#
# harvest_trajectory = true

# MCP facade capability scope (SPEC-0005 REQ "Capability Scoping"): the
# operations this harness will be permitted to invoke through the MCP facade.
# Defaults to ["read"] (read-only facade tools like harness_list,
# list_trajectories). Include "write" to permit harness_start/stop/restart
# through the facade. Global config only - project files reject this key so a
# cloned repository cannot grant itself write authority over the fleet.
#
# mcp_allow = ["read", "write"]

# A crash-looping example. The full restart_delay is seconds; the supervisor
# honours it once a harness exits while still enabled.
#
# restart mirrors Docker Compose's `restart` directive:
#   "no"              — never restart automatically
#   "always"          — always restart (the default; omitting the key is the
#                       same, backward compatible)
#   "unless-stopped"  — always restart, unless explicitly stopped (here this
#                       equals "always": a manual stop persists across daemon
#                       restarts under either value)
#   "on-failure"      — restart only on non-zero exit code
# Compose's "on-failure:<max-retries>" suffix is not supported; retry limits
# come from the daemon's crash-loop policy instead.
[harness.flaky]
harness = "generic"
args = ["-c", "exec /usr/local/bin/maybe-fails"]
workdir = "/srv/flaky"
restart_delay = 5
restart = "on-failure"
description = "service that sometimes falls over"
enabled = false

# --- Event triggers (ADR-0021 / SPEC-0014) --------------------------------
#
# A one-shot can be fired by an external event as well as by a clock. There are
# two kinds of trigger source, and which one you want is decided by where the
# daemon runs, not by what is sending the event:
#
#   * A CHANNEL source dials OUT to an MCP server and holds a listen-only
#     session. It needs no inbound port and no public URL, so it is the path
#     for a laptop behind NAT.
#   * A WEBHOOK source serves an authenticated route on an HTTP listener you
#     turn on explicitly. It needs to be reachable, so it is the path for a
#     server.
#
# A harness binds sources with `triggers`, and every firing goes through the
# same run machinery a `schedule` firing does: a run record, a per-run log,
# `timeout`, `on_overlap` and `keep_runs`. The event reaches the run as a
# private file named by HARNESS_EVENT_FILE — never as prompt text or argv.
#
# Harness is a TRIGGER, not a queue: nothing here buffers events durably, and
# an event whose loss matters belongs in a durable queue in front of Harness.

# A channel source: one MCP Streamable HTTP endpoint the daemon listens on.
# `url` must be https unless its host is loopback, and must not carry
# credentials — those go in `headers`, as a ${NAME} reference resolved from
# this source's own env_file. References never resolve from the daemon's
# environment, so the CLI and the daemon always agree.
[channel.switchboard]
url = "https://switchboard.example.com/mcp/my-agent-k3x9"
env_file = "~/.config/harness/triggers.env"
headers = { Authorization = "Bearer ${SB_TOKEN}" }
description = "switchboard doorbells for my-agent"

# A webhook source. The route is POST /hooks/<name> on the listener configured
# under [server] below; with no listener, the source is valid and simply has
# nowhere to be served (`harness triggers` shows it as no_listener).
#
# `verify` picks the authentication scheme: bearer, hmac-sha256, github,
# gitea, gitlab or standard-webhooks. The four presets fix their own header
# names, so setting signature_header/event_header alongside one is an error
# rather than a silently ignored override.
#
# `secret` must be exactly one ${NAME} reference — a literal is refused,
# because harness.toml is routinely committed to a dotfiles repository.
[webhook.gitea-pr]
verify = "gitea"
env_file = "~/.config/harness/triggers.env"
secret = "${GITEA_HOOK_SECRET}"
# Optional: only these event names fire the harness. Everything else is
# accepted, counted and dropped.
events = ["pull_request"]
# Optional: the largest body accepted (default "1MiB", ceiling "25MiB") and
# the delivery rate this route allows (default "60/m", "0" for no limit). Only
# verified, filtered, non-duplicate deliveries count against the rate; one over
# it gets 429 + Retry-After. A redelivered ID (X-Gitea-Delivery here) that
# already fired in the last 24 hours is answered "duplicate" and fires nothing.
max_body = "2MiB"
rate_limit = "120/m"
description = "gitea pull-request events"

# The harness the two sources fire. `triggers` requires a prompt source for
# the same reason `schedule` does — a triggered unit is a one-shot agent run —
# and is mutually exclusive with `enabled = true`, with profile membership,
# and with a respawning restart policy: each of those would fire the one-shot
# with no event for it to act on.
#
# `schedule` and `triggers` combine, so a harness may fire hourly AND on every
# doorbell.
#
# on_overlap defaults to "queue" here, not "skip". The asymmetry is
# deliberate: a cron firing that lands during a run is the same work coming
# round again, so skipping it loses nothing, while an event firing is a
# DIFFERENT event and dropping it loses work nothing will re-deliver.
#
# operating_hours on a triggered harness gates FIRINGS, not the process: an
# event out of hours starts nothing and is recorded `skipped` (reason
# `outside_hours`, a burst coalesced into one record), a run in flight at the
# close finishes under its `timeout`, and `catch_up = true` starts ONE run when
# hours next open if anything was skipped. `harness trigger` is never gated.
[harness.pr-review]
harness = "claude-code"
prompt_file = "~/.config/harness/prompts/pr-review.md"
triggers = ["webhook.gitea-pr", "channel.switchboard"]
timeout = "20m"
keep_runs = 50
description = "review a pull request when one arrives"
# operating_hours = "TZ=America/Los_Angeles Mon-Fri 09:00-18:00"
# catch_up = true

# Profiles (ADR-0006): named groups of harnesses that switch together via
# `harness use-profile <name>`. Only one profile is active at a time; the
# active profile is what `harness list` flags with *.

[profile.default]
description = "everyday set — just the heartbeat"
harnesses = ["heartbeat"]
autostart = true

[profile.full]
description = "all agents running"
harnesses = ["heartbeat", "my-agent"]
autostart = true

# The webhook listener (SPEC-0014 REQ "Webhook Listener") is part of [server]
# and is OFF unless an address names it — declaring a [webhook.*] table does
# not open a port. It is a server of its own, separate from the SSH front door
# below and from the metrics listener.
#
# `harness daemon --webhook-listen ADDR` or HARNESS_WEBHOOK_LISTEN override it.
# Only verify = "bearer" is implemented so far; a route using another scheme
# answers every delivery 401 until its verifier lands.
#
# [server]
# webhook_listen = "127.0.0.1:9080"
# # Both TLS keys or neither; setting one is a parse error, because a
# # half-configured pair is an operator who believes the listener is
# # encrypted when it is not. A non-loopback bind with no TLS starts, warns at
# # startup, and is flagged by `harness doctor`.
# webhook_tls_cert_file = "/etc/harness/webhook.crt"
# webhook_tls_key_file = "/etc/harness/webhook.key"

# Optional remote-access SSH front door (ADR-0004/ADR-0008). Off by default;
# flip enabled = true to expose the cockpit TUI over SSH. Only public keys
# listed here (or in authorized_keys_file) can connect — there is no
# password auth path.
#
# [server]
# enabled = false
# listen = "0.0.0.0:23234"
# authorized_keys_file = "~/.ssh/harness_authorized_keys"
#
# Per-key read-only scoping (ADR-0008): attach but don't type.
#   [[server.key]]
#   key = "ssh-ed25519 AAAA…"
#   read_only = true
#
# Prometheus metrics (ADR-0020, SPEC-0013). GET /metrics is served on
# 127.0.0.1:10229 whether or not the SSH server above is enabled. A change to
# either key needs a DAEMON RESTART — `harness reload` does not rebind the
# listener. Binding anything but loopback requires metrics_token_file (a path
# to a 0600 file holding the bearer token; never the token itself), or the
# daemon refuses to start. "off" disables the listener.
#
# metrics_listen = "127.0.0.1:10229"
# metrics_token_file = "~/.config/harness/metrics.token"
