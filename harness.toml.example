# harness.toml — example configuration.
#
# Copy to ~/.config/harness/harness.toml and edit. After editing, re-run
# `harness doctor` to verify the daemon picks it up. Full field reference:
# `harness daemon -h`.
#
# Default location: $XDG_CONFIG_HOME/harness/harness.toml
# (falls back to ~/.config/harness/harness.toml).

# Optional daemon-level settings (issue #98).
#
# [daemon]
# # watch_config controls whether the daemon watches this file for changes
# # and auto-reloads. Default is true (on). Set to false to require an
# # explicit `harness reload` or SIGHUP after config changes.
# watch_config = true
#
# # otel_endpoint is the OTLP/HTTP URL the daemon ships agent traces to.
# # Any OTLP-compatible endpoint works: Honeycomb, Tempo, Jaeger, Grafana,
# # or a Cairn instance exposing an OTLP endpoint. The daemon builds OTel
# # traces from harvested sessions (harvest_trajectory = true) and POSTs
# # them as standard OTLP JSON to <endpoint>/v1/traces. Harness does not
# # know or care what is on the other end.
# otel_endpoint = "https://cairn.stump.wtf"

# Each harness is one supervised process. The new-style [harness.<name>]
# form is preferred; a bare [name] table is supported for backward
# compatibility (ADR-0006).

# A simple always-on ticker. enabled = true means the daemon autostarts it
# on boot (ADR-0005 supervision: it gets restarted if it exits, with
# escalating backoff under crash-loop conditions).
[harness.heartbeat]
harness = "generic"
args = ["-c", "while true; do echo $(date); sleep 60; done"]
description = "prints the time once a minute"
enabled = true

# An agent CLI you drive from your phone via the remote SSH surface.
# Disabled by default so it doesn't spawn until you explicitly `harness start`.
[harness.my-agent]
harness = "claude-code"
args = ["--remote-control", "--dangerously-skip-permissions"]
workdir = "~/src/my-project"
description = "long-running agent in ~/src/my-project"
enabled = false

# An agent one-shot: give the harness a prompt instead of a cmd and the
# daemon synthesizes the agent invocation at spawn time (currently
# `crush run --quiet <prompt>`). `prompt` is mutually exclusive with
# `cmd`/`args`. One-shots default to restart = "no" — a completed run must
# not respawn; set restart explicitly to opt back into supervision.
[harness.deploy-check]
prompt = "check the deployments and report anything unhealthy"
model = "claude-opus-5"  # optional: which model the agent runs (requires prompt)
# auto_accept runs the agent unattended (currently crush's --yolo flag,
# synthesized at spawn). WARNING: this bypasses ALL of the agent's permission
# prompts — only enable it for trusted, headless runs. Requires `prompt`; a
# cmd harness passes its tool's own flag through `args` instead.
auto_accept = true
# max_turns caps how many iterations the agent may run before it stops — the
# budget guard for unattended one-shots (requires `prompt`; a cmd harness
# passes its tool's flag through `args`). 0 or omitted means unlimited.
max_turns = 20
# quiet runs the one-shot headless (suppresses agent output). It is the
# default for a prompt harness, so set quiet = false to have the agent stream
# its output to whatever attaches instead. Requires `prompt`; a cmd harness
# passes its tool's own tone flag through `args`.
# quiet = false
workdir = "~/src/my-project"
description = "one-shot agent run"
enabled = false

# A scheduled agent one-shot: the daemon fires it on a cron schedule. At each
# firing the harness starts if it is not already running (overlapping firings
# are skipped, not stacked). Requires `prompt`; is mutually exclusive with
# `enabled = true` and with profile membership. The run exiting is terminal
# for that firing — restart policy applies only to abnormal exit, so only
# `restart = "no"` (the prompt default) or `"on-failure"` are accepted here.
# The cron expression is validated at load; global config only (not project
# files).
#
# [harness.stumpcloud-sweep]
# prompt = "check all StumpCloud services and report anything unhealthy"
# auto_accept = true
# schedule = "0 */6 * * *"   # every 6 hours
# description = "scheduled sweep (every 6 hours)"

# Harness kinds (ADR-0011, SPEC-0006): the `harness` key is an enum selecting
# the adapter, which owns the executable a long-running harness runs (args are
# appended after it) and the CLI-specific argv synthesized for a prompt
# one-shot. Defaults to "crush" when omitted. "generic" runs through sh
# (arbitrary commands; no projection, scrollback-only trajectory).
# Valid values: "crush", "claude-code", "codex", "generic".
#
# harness = "claude-code"

# Trajectory harvesting (SPEC-0006 REQ "Harvest Opt-In"): expose this harness's
# session transcripts read-only through the facade (list_trajectories /
# get_trajectory). Defaults to false - a transcript may contain secrets the
# harnessed program printed itself (ADR-0008), so exposure is opt-in.
#
# harvest_trajectory = true

# MCP facade capability scope (SPEC-0005 REQ "Capability Scoping"): the
# operations this harness is permitted to invoke through the MCP facade.
# Defaults to ["read"] (read-only facade tools like harness_list,
# list_trajectories). Include "write" to permit harness_start/stop/restart
# through the facade. Global config only - project files reject this key so a
# cloned repository cannot grant itself write authority over the fleet.
#
# mcp_allow = ["read", "write"]

# A crash-looping example. The full restart_delay is seconds; the supervisor
# honours it once a harness exits while still enabled.
#
# restart mirrors Docker Compose's `restart` directive:
#   "no"              — never restart automatically
#   "always"          — always restart (the default; omitting the key is the
#                       same, backward compatible)
#   "unless-stopped"  — always restart, unless explicitly stopped (here this
#                       equals "always": a manual stop persists across daemon
#                       restarts under either value)
#   "on-failure"      — restart only on non-zero exit code
# Compose's "on-failure:<max-retries>" suffix is not supported; retry limits
# come from the daemon's crash-loop policy instead.
[harness.flaky]
harness = "generic"
args = ["/usr/local/bin/maybe-fails"]
workdir = "/srv/flaky"
restart_delay = 5
restart = "on-failure"
description = "service that sometimes falls over"
enabled = false

# Profiles (ADR-0006): named groups of harnesses that switch together via
# `harness use-profile <name>`. Only one profile is active at a time; the
# active profile is what `harness list` flags with *.

[profile.default]
description = "everyday set — just the heartbeat"
harnesses = ["heartbeat"]
autostart = true

[profile.full]
description = "all agents running"
harnesses = ["heartbeat", "my-agent"]
autostart = true

# Optional remote-access SSH front door (ADR-0004/ADR-0008). Off by default;
# flip enabled = true to expose the cockpit TUI over SSH. Only public keys
# listed here (or in authorized_keys_file) can connect — there is no
# password auth path.
#
# [server]
# enabled = false
# listen = "0.0.0.0:23234"
# authorized_keys_file = "~/.ssh/harness_authorized_keys"
#
# Per-key read-only scoping (ADR-0008): attach but don't type.
#   [[server.key]]
#   key = "ssh-ed25519 AAAA…"
#   read_only = true
